# Postgres — Prisma. From Supabase: Project Settings → Database → URI
# Use the pooler (6543) for DATABASE_URL, direct (5432) for DIRECT_URL.
# Copy this file to `.env.local` (Next.js + Prisma CLI both load it via prisma.config.ts).
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Public Supabase (auth + browser). Safe to expose; this is the anon key.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="anon-key"

# Storage — service_role bypasses RLS. Required for reliable video upload/playback.
# Supabase → Project Settings → API → service_role (secret).
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-key"
SUPABASE_MEDIA_BUCKET="media"

# Cookie signing for invite/admin fallback
SESSION_SECRET="generate-a-long-random-string"
ADMIN_SECRET="founder-admin-password"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production split (same Railway service, two hostnames):
# NEXT_PUBLIC_APP_URL="https://app.factbeatai.com"
# NEXT_PUBLIC_MARKETING_URL="https://factbeatai.com"
# COOKIE_DOMAIN=".factbeatai.com"

# Optional — drafts fall back to context-only if unset
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# Score-model V1 — train/compare via Gemini. Never commit the key.
GEMINI_API_KEY=""
GEMINI_MODEL_TRAIN="gemini-3.1-pro-preview"
GEMINI_MODEL_COMPARE="gemini-3.5-flash"
GEMINI_MODEL_DRAFT="gemini-3.5-flash"
# Optional. Catalog ingest uses the first teacher if unset.
CATALOG_TEACHER_ID=""

# Audio backends (worker). librosa is used when installed; stdlib is the fallback.
# ANALYZE_BACKEND="librosa"
# BASIC_PITCH="1"
