  "materials": {
    "ivory": {
      "label": "Ivory Frost",
      "rgb": "243 237 226",
      "alpha": 0.76,
      "hover-alpha": 0.84,
      "pressed-alpha": 0.9,
      "blur": "18px",
      "mobile-blur": "10px",
      "saturation": "1",
      "text": "#3B2F2A",
      "fallback": "#F3EDE2",
      "border": "243 237 226 / .68",
      "rim": "rgba(243,237,226,.64)",
      "shade": "rgba(59,47,42,.09)",
      "grain-opacity": 0.08,
      "grain-mobile": 0.045,
      "low-shadow": "0 4px 14px rgb(59 47 42 / .09)",
      "raised-shadow": "0 14px 36px rgb(59 47 42 / .15)",
      "use": "Sand fields and selected warm artwork; solid fallback Ivory."
    },
    "smoke": {
      "label": "Espresso Smoke",
      "rgb": "59 47 42",
      "alpha": 0.82,
      "hover-alpha": 0.88,
      "pressed-alpha": 0.92,
      "blur": "20px",
      "mobile-blur": "10px",
      "saturation": ".96",
      "text": "#F3EDE2",
      "fallback": "#3B2F2A",
      "border": "243 237 226 / .24",
      "rim": "rgba(243,237,226,.2)",
      "shade": "rgba(59,47,42,.3)",
      "grain-opacity": 0.065,
      "grain-mobile": 0.04,
      "low-shadow": "0 4px 14px rgb(59 47 42 / .16)",
      "raised-shadow": "0 14px 36px rgb(59 47 42 / .23)",
      "use": "Espresso-led compositions; future stage photos only after testing the actual crop."
    },
    "quiet": {
      "label": "Quiet Glass",
      "rgb": "243 237 226",
      "alpha": 0.88,
      "hover-alpha": 0.94,
      "pressed-alpha": 0.97,
      "blur": "6px",
      "mobile-blur": "0px",
      "saturation": "1",
      "text": "#3B2F2A",
      "fallback": "#F3EDE2",
      "border": "59 47 42 / .22",
      "rim": "rgba(243,237,226,.38)",
      "shade": "rgba(59,47,42,.055)",
      "grain-opacity": 0.035,
      "grain-mobile": 0,
      "low-shadow": "0 2px 6px rgb(59 47 42 / .05)",
      "raised-shadow": "0 6px 18px rgb(59 47 42 / .1)",
      "use": "Compact surfaces on quiet light backgrounds. No backdrop blur or grain on mobile."
    }
