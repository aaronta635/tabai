{
  "version": "1.0",
  "scope": "Standalone additive glass materials; approved identity unchanged",
  "foundation": {
    "espresso": "#3B2F2A",
    "saddle-brown": "#8B5E34",
    "sand": "#D6B98C",
    "ivory": "#F3EDE2",
    "cool-grey": "#6B7280"
